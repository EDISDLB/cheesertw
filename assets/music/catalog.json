        "defeat": "defeat",
        "draw": "draw"
      },
      "RESULTS": {
        "cue": "results_theme"
      }
    },
    "transitions": [
      {
        "from": "BOOT",
        "to": "MENU",
        "fadeInS": 2.0,
        "quantize": "none"
      },
      {
        "from": "MENU",
        "to": "GARAGE",
        "crossfadeS": 3.0,
        "quantize": "none"
      },
      {
        "from": "GARAGE",
        "to": "LOADING",
        "fadeOutS": 1.5,
        "quantize": "none",
        "note": "map stinger starts at once; loading_theme starts at the stinger's bodyEndS with a 1.5 s overlap"
      },
      {
        "from": "LOADING",
        "to": "BATTLE",
        "fadeOutS": 0.6,
        "quantize": "countdownGo",
        "note": "all three stems start together, scheduled so bar 1 lands on GO; base fades in over 1 bar"
      },
      {
        "from": "BATTLE",
        "to": "BATTLE_ENDGAME",
        "crossfadeS": 2.0,
        "quantize": "bar",
        "note": "same tempo and grid: endgame starts on the next bar line at the same bar position modulo its length"
      },
      {
        "from": "BATTLE|BATTLE_ENDGAME",
        "to": "RESULT_STINGER",
        "fadeOutS": 0.5,
        "quantize": "beat"
      },
      {
        "from": "RESULT_STINGER",
        "to": "RESULTS",
        "crossfadeS": 3.0,
        "quantize": "stingerBodyEnd"
      },
      {
        "from": "RESULTS",
        "to": "GARAGE",
        "crossfadeS": 3.0,
        "quantize": "none"
      },
      {
