--!strict
--[[
	Shared/Assets/AssetManifest — GENERATED by tools/assets (asset upload pipeline). DO NOT EDIT BY HAND.

	Purpose:          Uploaded Roblox asset ids keyed by asset key. Images: "<folder>/<file stem>" mirroring
	                  assets/icons (e.g. "classes/heavy", "currency/credits", "modules/engine_damaged"). Sounds: the
	                  audio catalogue key (e.g. "ui_click"); one-shots may point into a bank with a playback region.
	Dependencies:     None (data only).
	State:            Constant table, rewritten by the pipeline after each upload run.
	Validation:       AssetResolver.validateManifest (run by tests/Unit/ReplicatedStorage/Shared/Assets).
	Error handling:   N/A — missing keys are handled by AssetResolver fallbacks.
	Performance notes: Loaded once; lookups are table indexing.

	Format (version 1):
	  images[key] = { id = "rbxassetid://<n>", size = Vector2?, rectOffset = Vector2?, rectSize = Vector2? }
	  sounds[key] = { id = "rbxassetid://<n>", durationS = number, loop = boolean, bus = "<Bus>", volume = number,
	                  region = { startS = number, endS = number }?, priority = number? }
	Ships empty until the first upload; every icon then renders its glyph fallback and sounds stay silent.
]]

export type ImageEntry = {
	id: string,
	size: Vector2?,
	rectOffset: Vector2?,
	rectSize: Vector2?,
}

export type SoundEntry = {
	id: string,
	durationS: number,
	loop: boolean,
	bus: string,
	volume: number,
	region: { startS: number, endS: number }?,
	priority: number?,
}

export type Manifest = {
	version: number,
	generatedAt: string,
	images: { [string]: ImageEntry },
	sounds: { [string]: SoundEntry },
}

local manifest: Manifest = {
	version = 1,
	generatedAt = "",
	images = {},
	sounds = {},
}

return manifest
