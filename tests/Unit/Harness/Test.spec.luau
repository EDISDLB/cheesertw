-- Harness self-test: matchers pass/fail correctly (including .never) with readable messages.
local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local function failureOf(fn: () -> ()): string
	local ok, err = pcall(fn)
	assert(not ok, "expected the matcher to fail")
	return tostring(err)
end

describe("expect matchers", function()
	it("toBe compares by identity and treats NaN as NaN", function()
		expect(1).toBe(1)
		expect(0 / 0).toBe(0 / 0)
		expect({}).never.toBe({})
		expect(failureOf(function()
			expect(1).toBe(2)
		end)).toContain("expected 1 to be 2")
	end)

	it("toEqual compares deeply with a readable diff", function()
		expect({ a = { 1, 2 }, b = "x" }).toEqual({ a = { 1, 2 }, b = "x" })
		expect({ a = 1 }).never.toEqual({ a = 2 })
		local message = failureOf(function()
			expect({ a = { b = 1 }, c = 2 }).toEqual({ a = { b = 2 }, d = 3 })
		end)
		expect(message).toContain(".a.b: expected 2, received 1")
		expect(message).toContain(".d: missing in received")
		expect(message).toContain(".c: unexpected in received")
	end)

	it("toBeCloseTo works for numbers, vectors and CFrames", function()
		expect(0.1 + 0.2).toBeCloseTo(0.3)
		expect(1.0).toBeCloseTo(1.05, 0.1)
		expect(1.0).never.toBeCloseTo(1.5, 0.1)
		expect(Vector3.new(1, 2, 3)).toBeCloseTo(Vector3.new(1, 2, 3.0000001))
		expect(CFrame.new(1, 2, 3)).toBeCloseTo(CFrame.new(1, 2, 3))
	end)

	it("nil/truthy/falsy", function()
		expect(nil).toBeNil()
		expect(false).never.toBeNil()
		expect(0).toBeTruthy()
		expect(false).toBeFalsy()
		expect(nil).toBeFalsy()
	end)

	it("numeric comparisons", function()
		expect(2).toBeGreaterThan(1)
		expect(2).toBeGreaterThanOrEqual(2)
		expect(1).toBeLessThan(2)
		expect(2).toBeLessThanOrEqual(2)
		expect(1).never.toBeGreaterThan(2)
		expect(failureOf(function()
			expect("a" :: any).toBeGreaterThan(1)
		end)).toContain("expected numbers")
	end)

	it("toContain and toHaveLength", function()
		expect({ 1, 2, 3 }).toContain(2)
		expect({ 1, 2, 3 }).never.toContain(4)
		expect("hello world").toContain("o w")
		expect({ 1, 2 }).toHaveLength(2)
		expect("abc").toHaveLength(3)
	end)

	it("toThrow with optional plain substring", function()
		expect(function()
			error("boom (with parens)")
		end).toThrow("boom (with parens)")
		expect(function() end).never.toThrow()
		expect(failureOf(function()
			expect(function()
				error("other")
			end).toThrow("boom")
		end)).toContain('expected error containing "boom"')
	end)

	it("toBeOk / toBeErr for Results", function()
		expect({ ok = true, value = 1 }).toBeOk()
		expect({ ok = false, err = "NOT_FOUND" }).toBeErr()
		expect({ ok = false, err = "NOT_FOUND" }).toBeErr("NOT_FOUND")
		expect({ ok = false, err = "NOT_FOUND" }).never.toBeErr("INTERNAL")
		expect(failureOf(function()
			expect({ ok = false, err = "X", detail = "why" }).toBeOk()
		end)).toContain("why")
	end)

	it("toBeType and toMatch", function()
		expect(Vector3.zero).toBeType("Vector3")
		expect("abc123").toMatch("^%a+%d+$")
		expect("abc").never.toMatch("%d")
	end)
end)

describe("spies", function()
	it("records calls and forwards to the implementation", function()
		local spy = Test.spy(function(a, b)
			return a + b
		end)
		expect(spy.fn(1, 2)).toBe(3)
		expect(spy:count()).toBe(1)
		expect(spy.calls[1][2]).toBe(2)
		spy:reset()
		expect(spy:count()).toBe(0)
	end)
end)

describe("hooks", function()
	local log = {}
	Test.beforeAll(function()
		table.insert(log, "beforeAll")
	end)
	Test.beforeEach(function()
		table.insert(log, "beforeEach")
	end)
	Test.afterEach(function()
		table.insert(log, "afterEach")
	end)

	it("first", function()
		expect(log).toEqual({ "beforeAll", "beforeEach" })
	end)

	it("second", function()
		expect(log).toEqual({ "beforeAll", "beforeEach", "afterEach", "beforeEach" })
	end)

	it("supports yielding tests", function()
		task.wait(0.01)
		expect(true).toBe(true)
	end)

	it.skip("is skipped", function()
		error("must not run")
	end)
end)
