-- Harness self-test: the Lune loader must resolve requires exactly like Roblox / luau-lsp.
local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local Loader = require("@tests/Harness/Loader")

describe("Loader require semantics", function()
	it("resolves ./ from a regular module to a sibling file", function()
		local sibling = require("@tests/Fixtures/RequireSemantics/Sibling")
		expect(sibling.name).toBe("Sibling")
		expect(sibling.leaf.name).toBe("Leaf")
	end)

	it("resolves @self, ./ and ../ from an init module", function()
		local folder = require("@tests/Fixtures/RequireSemantics/Folder")
		expect(folder.name).toBe("Folder")
		expect(folder.child.name).toBe("Child")
		expect(folder.sibling.name).toBe("Leaf")
		expect(folder.viaParent.name).toBe("Leaf")
	end)

	it("resolves ../ from a module inside a folder module", function()
		local child = require("@tests/Fixtures/RequireSemantics/Folder/Child")
		expect(child.up.name).toBe("Leaf")
	end)

	it("resolves nested init modules", function()
		local deep = require("@tests/Fixtures/RequireSemantics/Folder/Deep")
		expect(deep.inner.name).toBe("Inner")
		expect(deep.sibling.name).toBe("Child")
	end)

	it("returns the same cached instance within one spec file", function()
		local a = require("@tests/Fixtures/RequireSemantics/Leaf")
		local b = require("@tests/Fixtures/RequireSemantics/Sibling").leaf
		expect(a).toBe(b)
		local counter = require("@tests/Fixtures/RequireSemantics/Counter")
		local first = counter.inc()
		expect(require("@tests/Fixtures/RequireSemantics/Counter").inc()).toBe(first + 1)
	end)

	it("gives a fresh module cache to every Loader (one per spec file)", function()
		local loaderA = Loader.new()
		local loaderB = Loader.new()
		local counterA = loaderA:require("@tests/Fixtures/RequireSemantics/Counter")
		local counterB = loaderB:require("@tests/Fixtures/RequireSemantics/Counter")
		expect(counterA).never.toBe(counterB)
		expect(counterA.inc()).toBe(1)
		expect(counterA.inc()).toBe(2)
		expect(counterB.inc()).toBe(1)
	end)

	it("resolves @game to src", function()
		local Result = require("@game/ReplicatedStorage/Shared/Core/Result")
		expect(Result.ok(1).value).toBe(1)
	end)

	it("passes @lune requires through", function()
		local serde = require("@lune/serde")
		expect(type(serde.encode)).toBe("function")
	end)

	it("rejects requiring a Script", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Runnable")
		end).toThrow("not a ModuleScript")
	end)

	it("rejects requiring a folder without init", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/NoInit")
		end).toThrow("has no init module")
		expect(require("@tests/Fixtures/RequireSemantics/NoInit/Thing").name).toBe("Thing")
	end)

	it("rejects missing modules with the requested path", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/DoesNotExist")
		end).toThrow("module not found")
	end)

	it("rejects modules that return no value", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Nothing")
		end).toThrow("did not return exactly one value")
	end)

	it("reports cyclic requires with the chain", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Cycle/A")
		end).toThrow("cyclic require")
	end)

	it("rejects @self outside init modules", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/SelfInNonInit")
		end).toThrow("only valid inside init modules")
	end)

	it("rejects unknown aliases and bare paths", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Unknown")
		end).toThrow("unknown alias")
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Bare")
		end).toThrow("must start with")
	end)

	it("propagates load errors and allows a retry", function()
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Explodes")
		end).toThrow("fixture exploded on purpose")
		expect(function()
			require("@tests/Fixtures/RequireSemantics/Explodes")
		end).toThrow("fixture exploded on purpose")
	end)

	it("injects Roblox datatypes, task, game/workspace and mock Instances", function()
		local g = require("@tests/Fixtures/RequireSemantics/Globals")
		expect(g.vector).toEqual(Vector3.new(1, 2, 3))
		expect(typeof(g.cframe)).toBe("CFrame")
		expect(typeof(g.color)).toBe("Color3")
		expect(typeof(g.udim2)).toBe("UDim2")
		expect(g.material).toBe(Enum.Material.Grass)
		expect(g.hasTask).toBe(true)
		expect(g.gameType).toBe("Instance")
		expect(g.workspaceName).toBe("Workspace")
		expect(g.instanceType).toBe("Instance")
		expect(g.dateTime).toBeGreaterThan(1600000000)
	end)

	it("maps files to instance paths like Rojo", function()
		local segments = Loader._internals.instanceSegments
		expect(segments("src/A/B.luau")).toEqual({ "src", "A", "B" })
		expect(segments("src/A/B/init.luau")).toEqual({ "src", "A", "B" })
		expect(segments("src/A/Main.server.luau")).toEqual({ "src", "A", "Main" })
		expect(segments("tests/Unit/X.spec.luau")).toEqual({ "tests", "Unit", "X.spec" })
	end)
end)
