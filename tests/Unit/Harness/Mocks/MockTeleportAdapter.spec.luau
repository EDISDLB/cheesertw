local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local MockTeleportAdapter = require("@tests/Harness/Mocks/MockTeleportAdapter")

describe("MockTeleportAdapter", function()
	it("reserves unique servers and records teleports", function()
		local adapter = MockTeleportAdapter.new()
		local ok, reserved = adapter:reserveServerAsync(1234)
		expect(ok).toBe(true)
		expect(reserved.accessCode).toBe("access-0001")
		expect(reserved.privateServerId).toBe("ps-0001")
		local _, second = adapter:reserveServerAsync(1234)
		expect(second.privateServerId).never.toBe(reserved.privateServerId)
		local p = game:GetService("Players"):addPlayer({ UserId = 10 })
		expect((adapter:teleportAsync(1234, { p }, { reservedServerAccessCode = reserved.accessCode }))).toBe(true)
		expect(adapter.teleports[1].userIds).toEqual({ 10 })
		expect(adapter.teleports[1].spec.reservedServerAccessCode).toBe("access-0001")
	end)

	it("fails on demand and simulates TeleportInitFailed", function()
		local adapter = MockTeleportAdapter.new()
		adapter:failNext("reserveServerAsync", 1, "HTTP 500")
		local ok, err = adapter:reserveServerAsync(1)
		expect(ok).toBe(false)
		expect(err).toBe("HTTP 500")
		expect((adapter:teleportAsync(1, {}))).toBe(false)
		local failures = {}
		adapter.TeleportFailed:Connect(function(player, result, message)
			table.insert(failures, { player, result, message })
		end)
		adapter:simulateTeleportFailure("p", "GameFull", "full")
		expect(failures[1]).toEqual({ "p", "GameFull", "full" })
	end)
end)
