local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local MockMessagingAdapter = require("@tests/Harness/Mocks/MockMessagingAdapter")

describe("MockMessagingAdapter", function()
	it("delivers to every subscriber on the bus, including the publisher", function()
		local bus = MockMessagingAdapter.newBus()
		local hubA = MockMessagingAdapter.new({ bus = bus })
		local hubB = MockMessagingAdapter.new({ bus = bus })
		local received = {}
		hubA:subscribeAsync("Matches", function(message)
			table.insert(received, "A:" .. message.id)
		end)
		hubB:subscribeAsync("Matches", function(message, sentAt)
			table.insert(received, "B:" .. message.id)
			expect(sentAt).toBeGreaterThan(0)
		end)
		expect((hubA:publishAsync("Matches", { id = "m1" }))).toBe(true)
		expect(received).toEqual({ "A:m1", "B:m1" })
		expect(hubA.published[1].topic).toBe("Matches")
	end)

	it("deferred buses deliver on flush and disconnect stops delivery", function()
		local bus = MockMessagingAdapter.newBus({ deferred = true })
		local adapter = MockMessagingAdapter.new({ bus = bus })
		local count = 0
		local _, connection = adapter:subscribeAsync("T", function()
			count += 1
		end)
		adapter:publishAsync("T", "x")
		expect(count).toBe(0)
		expect(bus:pending()).toBe(1)
		expect(bus:flush()).toBe(1)
		expect(count).toBe(1)
		connection:Disconnect()
		adapter:publishAsync("T", "y")
		bus:flush()
		expect(count).toBe(1)
	end)

	it("enforces limits and records subscriber errors", function()
		local adapter = MockMessagingAdapter.new()
		expect((adapter:publishAsync(string.rep("t", 81), 1))).toBe(false)
		expect((adapter:publishAsync("T", string.rep("x", 2000)))).toBe(false)
		expect((adapter:publishAsync("T", { fn = function() end }))).toBe(false)
		adapter:subscribeAsync("T", function()
			error("subscriber broke")
		end)
		expect((adapter:publishAsync("T", 1))).toBe(true)
		expect(adapter.bus.errors[1]).toContain("subscriber broke")
		adapter:failNext("publishAsync")
		expect((adapter:publishAsync("T", 1))).toBe(false)
	end)
end)
