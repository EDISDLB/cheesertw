local Test = require("@tests/Harness/Test")
local FakeClock = require("@tests/Harness/FakeClock")
local describe, it, expect = Test.describe, Test.it, Test.expect

local MockDataStoreAdapter = require("@tests/Harness/Mocks/MockDataStoreAdapter")

local store

Test.beforeEach(function()
	store = MockDataStoreAdapter.new({ clock = FakeClock.new(1000) })
end)

describe("MockDataStoreAdapter basics", function()
	it("get/set/remove with copies (no aliasing)", function()
		local value = { credits = 100, vehicles = { "t1" } }
		local ok, version = store:setAsync("Profiles", "u1", value, { 1 }, { schema = 1 })
		expect(ok).toBe(true)
		expect(type(version)).toBe("string")
		value.credits = 0
		local okGet, got, info = store:getAsync("Profiles", "u1")
		expect(okGet).toBe(true)
		expect(got.credits).toBe(100)
		expect(info.userIds).toEqual({ 1 })
		expect(info.metadata).toEqual({ schema = 1 })
		expect(info.version).toBe(version)
		expect(info.createdTime).toBe(1000000)
		got.credits = 5
		expect(store:peek("Profiles", "u1").credits).toBe(100)
		local okRemove, previous = store:removeAsync("Profiles", "u1")
		expect(okRemove).toBe(true)
		expect(previous.credits).toBe(100)
		local _, afterRemove, afterInfo = store:getAsync("Profiles", "u1")
		expect(afterRemove).toBeNil()
		expect(afterInfo).toBeNil()
	end)

	it("missing keys read as (true, nil)", function()
		local ok, value = store:getAsync("Profiles", "nobody")
		expect(ok).toBe(true)
		expect(value).toBeNil()
	end)

	it("validates keys and values like Roblox", function()
		local ok, err = store:setAsync("Profiles", "", 1)
		expect(ok).toBe(false)
		expect(err).toContain("101")
		ok, err = store:setAsync("Profiles", string.rep("k", 51), 1)
		expect(err).toContain("102")
		ok, err = store:setAsync("Profiles", "k", { fn = function() end })
		expect(err).toContain("104")
		ok, err = store:setAsync("Profiles", "k", { 1, nil, 3 })
		expect(ok).toBe(false)
		ok, err = store:setAsync("Profiles", "k", { [1] = 1, a = 2 })
		expect(err).toContain("mixed")
		ok, err = store:setAsync("Profiles", "k", { v = Vector3.zero })
		expect(err).toContain("104")
		ok, err = store:setAsync("Profiles", "k", { s = "\255" })
		expect(err).toContain("UTF-8")
		ok, err = store:setAsync("Profiles", "k", string.rep("x", 4194310))
		expect(err).toContain("105")
	end)
end)

describe("MockDataStoreAdapter UpdateAsync semantics", function()
	it("passes the current value and keyInfo, writes the result", function()
		store:seed("Profiles", "u1", { credits = 10 })
		local seen
		local ok, newValue, info = store:updateAsync("Profiles", "u1", function(current, keyInfo)
			seen = { credits = current.credits, version = keyInfo and keyInfo.version }
			current.credits += 5
			return current, { 1 }, { lock = "job-1" }
		end)
		expect(ok).toBe(true)
		expect(seen.credits).toBe(10)
		expect(seen.version).never.toBeNil()
		expect(newValue.credits).toBe(15)
		expect(info.userIds).toEqual({ 1 })
		expect(info.metadata).toEqual({ lock = "job-1" })
		expect(store:peek("Profiles", "u1").credits).toBe(15)
	end)

	it("nil from the transform cancels the write", function()
		store:seed("Profiles", "u1", { credits = 10 })
		local ok, value = store:updateAsync("Profiles", "u1", function()
			return nil
		end)
		expect(ok).toBe(true)
		expect(value).toBeNil()
		expect(store:peek("Profiles", "u1").credits).toBe(10)
	end)

	it("missing keys pass (nil, nil) to the transform", function()
		local args
		store:updateAsync("Profiles", "fresh", function(current, info)
			args = { current, info }
			return { created = true }
		end)
		expect(args[1]).toBeNil()
		expect(args[2]).toBeNil()
		expect(store:peek("Profiles", "fresh")).toEqual({ created = true })
	end)

	it("re-runs the transform after a concurrent write (session-lock style)", function()
		store:seed("Profiles", "u1", { lock = nil, credits = 1 })
		store:injectConcurrentWrite("Profiles", "u1", { lock = "other-server", credits = 1 })
		local seenLocks = {}
		local ok, value = store:updateAsync("Profiles", "u1", function(current)
			table.insert(seenLocks, current.lock or "none")
			if current.lock ~= nil then
				return nil -- someone else holds the lock: abort
			end
			current.lock = "me"
			return current
		end)
		expect(ok).toBe(true)
		expect(value).toBeNil()
		expect(seenLocks).toEqual({ "none", "other-server" })
		expect(store.transformCalls).toBe(2)
		expect(store:peek("Profiles", "u1").lock).toBe("other-server")
	end)

	it("transform errors and yields fail the call", function()
		local ok, err = store:updateAsync("Profiles", "u1", function()
			error("bad transform")
		end)
		expect(ok).toBe(false)
		expect(err).toContain("bad transform")
		ok, err = store:updateAsync("Profiles", "u1", function()
			coroutine.yield()
			return 1
		end)
		expect(ok).toBe(false)
		expect(err).toContain("cannot yield")
	end)
end)

describe("MockDataStoreAdapter failures, budgets, versions", function()
	it("injected failures carry Roblox-style codes", function()
		store:failNext("getAsync", 2)
		local ok1, err1 = store:getAsync("S", "k")
		local ok2 = store:getAsync("S", "k")
		local ok3 = store:getAsync("S", "k")
		expect(ok1).toBe(false)
		expect(err1).toContain("502")
		expect(ok2).toBe(false)
		expect(ok3).toBe(true)
		store:failAlways("setAsync", "503: down")
		local okSet, errSet = store:setAsync("S", "k", 1)
		expect(okSet).toBe(false)
		expect(errSet).toBe("503: down")
		store:clearFailures()
		expect((store:setAsync("S", "k", 1))).toBe(true)
		expect(store.injector:callCount("getAsync")).toBe(3)
	end)

	it("budgets throttle requests (UpdateAsync consumes Get and Set)", function()
		store:setBudget("Get", 1)
		expect((store:getAsync("S", "k"))).toBe(true)
		local ok, err = store:getAsync("S", "k")
		expect(ok).toBe(false)
		expect(err).toContain("301")
		expect(store:getRequestBudget("Get")).toBe(0)
		expect(store:getRequestBudget("Update")).toBe(0)
		store:setBudget("Get", 5)
		store:setBudget("Set", 5)
		store:updateAsync("S", "k", function()
			return 1
		end)
		expect(store:getRequestBudget("Get")).toBe(4)
		expect(store:getRequestBudget("Set")).toBe(4)
	end)

	it("keeps version history including deletions", function()
		store:setAsync("S", "k", { v = 1 })
		store:setAsync("S", "k", { v = 2 })
		store:removeAsync("S", "k")
		local ok, versions = store:listVersionsAsync("S", "k")
		expect(ok).toBe(true)
		expect(#versions).toBe(3)
		expect(versions[1].isDeleted).toBe(true)
		expect(versions[3].isDeleted).toBe(false)
		local okVersion, old = store:getVersionAsync("S", "k", versions[3].version)
		expect(okVersion).toBe(true)
		expect(old).toEqual({ v = 1 })
		local _, limited = store:listVersionsAsync("S", "k", 1)
		expect(#limited).toBe(1)
	end)

	it("increments numbers and rejects non-numbers", function()
		expect(select(2, store:incrementAsync("S", "count", 5))).toBe(5)
		expect(select(2, store:incrementAsync("S", "count", -2))).toBe(3)
		store:seed("S", "text", "x")
		local ok, err = store:incrementAsync("S", "text", 1)
		expect(ok).toBe(false)
		expect(err).toContain("non-numeric")
	end)
end)
