local Test = require("@tests/Harness/Test")
local Format = require("@game/ReplicatedStorage/Client/UI/Kit/Format")

local describe, it, expect = Test.describe, Test.it, Test.expect
local M = Format.MINUS

describe("Format", function()
	it("groups thousands and rounds half away from zero", function()
		expect(Format.integer(0)).toBe("0")
		expect(Format.integer(999)).toBe("999")
		expect(Format.integer(1000)).toBe("1,000")
		expect(Format.integer(12400)).toBe("12,400")
		expect(Format.integer(1234567)).toBe("1,234,567")
		expect(Format.integer(2.5)).toBe("3")
		expect(Format.integer(-2.5)).toBe(M .. "3")
		expect(Format.integer(-15000)).toBe(M .. "15,000")
		expect(Format.integer(-0.4)).toBe("0")
		expect(Format.number(1234.5, 2)).toBe("1,234.50")
		expect(Format.number(0.344, 2)).toBe("0.34")
		expect(Format.number(-0.04, 1)).toBe("0.0")
		expect(Format.groupDigits("1234567890")).toBe("1,234,567,890")
	end)

	it("formats invalid numbers as a dash", function()
		expect(Format.integer(0 / 0)).toBe(Format.INVALID)
		expect(Format.integer(math.huge)).toBe(Format.INVALID)
		expect(Format.signed(-math.huge)).toBe(Format.INVALID)
		expect(Format.compact(0 / 0)).toBe(Format.INVALID)
		expect(Format.percent(0 / 0)).toBe(Format.INVALID)
		expect(Format.seconds(0 / 0)).toBe(Format.INVALID)
		expect(Format.delta(0 / 0).text).toBe(Format.INVALID)
	end)

	it("signs values and deltas with tones", function()
		expect(Format.signed(1240)).toBe("+1,240")
		expect(Format.signed(-0.4, 1)).toBe(M .. "0.4")
		expect(Format.signed(0)).toBe("0")
		expect(Format.signed(0.04, 1)).toBe("0.0")
		local better = Format.delta(18, { unit = "mm" })
		expect(better).toEqual({ text = "+18 mm", tone = "success", sign = 1 })
		local reload = Format.delta(-0.4, { decimals = 1, unit = "s", lowerIsBetter = true })
		expect(reload).toEqual({ text = M .. "0.4 s", tone = "success", sign = -1 })
		local worse = Format.delta(0.4, { decimals = 1, unit = "s", lowerIsBetter = true })
		expect(worse.tone).toBe("danger")
		local none = Format.delta(0.01, { decimals = 1 })
		expect(none).toEqual({ text = "0.0", tone = "neutral", sign = 0 })
		expect(Format.delta(-5).tone).toBe("danger")
	end)

	it("compacts large amounts", function()
		expect(Format.compact(950)).toBe("950")
		expect(Format.compact(1000)).toBe("1K")
		expect(Format.compact(12400)).toBe("12.4K")
		expect(Format.compact(1250000)).toBe("1.25M")
		expect(Format.compact(3000000000)).toBe("3B")
		expect(Format.compact(456789)).toBe("457K")
		expect(Format.compact(-2500)).toBe(M .. "2.5K")
	end)

	it("formats percent, units and seconds", function()
		expect(Format.percent(0.125)).toBe("13%")
		expect(Format.percent(0.125, 1)).toBe("12.5%")
		expect(Format.unit(54, "km/h")).toBe("54 km/h")
		expect(Format.unit(0.34, "m", 2)).toBe("0.34 m")
		expect(Format.seconds(7.44)).toBe("7.4 s")
		expect(Format.seconds(12.4)).toBe("12 s")
		expect(Format.seconds(9.96)).toBe("10.0 s")
	end)

	it("formats clocks and timers", function()
		expect(Format.clock(720)).toBe("12:00")
		expect(Format.clock(65)).toBe("1:05")
		expect(Format.clock(3725)).toBe("1:02:05")
		expect(Format.clock(-5)).toBe("0:00")
		expect(Format.clock(0.2, true)).toBe("0:01")
		expect(Format.clock(0.2)).toBe("0:00")
		expect(Format.timer(7.46)).toBe("7.4")
		expect(Format.timer(125.2)).toBe("2:06")
		expect(Format.timer(-1)).toBe("0.0")
	end)

	it("writes roman tier numerals", function()
		local expected = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI" }
		for tier, numeral in expected do
			expect(Format.roman(tier)).toBe(numeral)
		end
		expect(Format.roman(1994)).toBe("MCMXCIV")
		expect(Format.tier(7)).toBe("Tier VII")
		expect(function()
			Format.roman(0)
		end).toThrow("1..3999")
		expect(function()
			Format.roman(2.5)
		end).toThrow("1..3999")
		expect(Format.upper("To battle")).toBe("TO BATTLE")
	end)
end)
