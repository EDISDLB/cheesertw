local Test = require("@tests/Harness/Test")
local Support = require("@tests/Unit/ReplicatedStorage/Client/UI/KitTestSupport")
local InputMode = require("@game/ReplicatedStorage/Client/UI/Kit/InputMode")

local describe, it, expect = Test.describe, Test.it, Test.expect

local env = Support.install()

describe("InputMode detection", function()
	it("maps PreferredInput and UserInputType to modes", function()
		expect(InputMode.fromPreferredInput(Enum.PreferredInput.KeyboardAndMouse)).toBe("MouseKeyboard")
		expect(InputMode.fromPreferredInput(Enum.PreferredInput.Gamepad)).toBe("Gamepad")
		expect(InputMode.fromPreferredInput(Enum.PreferredInput.Touch)).toBe("Touch")
		expect(InputMode.fromPreferredInput({ Name = "MicroGamepad" } :: any)).toBe("Gamepad")
		expect(InputMode.fromPreferredInput(nil)).toBeNil()
		expect(InputMode.fromUserInputType(Enum.UserInputType.Keyboard)).toBe("MouseKeyboard")
		expect(InputMode.fromUserInputType(Enum.UserInputType.MouseMovement)).toBe("MouseKeyboard")
		expect(InputMode.fromUserInputType(Enum.UserInputType.Gamepad2)).toBe("Gamepad")
		expect(InputMode.fromUserInputType(Enum.UserInputType.Touch)).toBe("Touch")
		expect(InputMode.fromUserInputType(Enum.UserInputType.Focus)).toBeNil()
	end)

	it("follows PreferredInput after start() and stops cleanly", function()
		local seen = {}
		local connection = InputMode.mode:onChange(function(mode)
			table.insert(seen, mode)
		end)
		env:setPreferredInput(Enum.PreferredInput.Gamepad)
		local stop = InputMode.start()
		expect(InputMode.mode:peek()).toBe("Gamepad")
		expect(InputMode.isGamepad:peek()).toBe(true)
		env:setPreferredInput(Enum.PreferredInput.Touch)
		expect(InputMode.mode:peek()).toBe("Touch")
		expect(InputMode.isTouch:peek()).toBe(true)
		stop()
		env:setPreferredInput(Enum.PreferredInput.KeyboardAndMouse)
		expect(InputMode.mode:peek()).toBe("Touch")
		expect(seen).toEqual({ "Gamepad", "Touch" })
		connection:Disconnect()
		InputMode.set("MouseKeyboard")
	end)

	it("falls back to the last input type without PreferredInput", function()
		rawget(env.userInputService, "_props").PreferredInput = nil
		rawset(env.userInputService, "_lastInputType", Enum.UserInputType.Gamepad1)
		local stop = InputMode.start()
		expect(InputMode.mode:peek()).toBe("Gamepad")
		env.userInputService.LastInputTypeChanged:Fire(Enum.UserInputType.Touch)
		expect(InputMode.mode:peek()).toBe("Touch")
		env.userInputService.LastInputTypeChanged:Fire(Enum.UserInputType.Focus)
		expect(InputMode.mode:peek()).toBe("Touch")
		stop()
		rawget(env.userInputService, "_props").PreferredInput = Enum.PreferredInput.KeyboardAndMouse
		InputMode.set("MouseKeyboard")
	end)

	it("rejects unknown modes", function()
		expect(function()
			InputMode.set("Wheel" :: any)
		end).toThrow("unknown mode")
	end)
end)

describe("InputMode glyphs", function()
	Test.afterEach(function()
		InputMode.set("MouseKeyboard")
		rawset(env.userInputService, "_playstation", nil)
	end)

	it("shows keyboard keys in MouseKeyboard mode", function()
		local confirm = InputMode.glyph("Confirm")
		expect(confirm.kind).toBe("key")
		expect(confirm.keyCode).toBe(Enum.KeyCode.Return)
		expect(confirm.text).toBe("Enter")
		expect(InputMode.glyph("Back").text).toBe("Bksp")
		expect(InputMode.glyph("TabPrev").text).toBe("Q")
		expect(InputMode.glyph(Enum.KeyCode.Left).text).toBe("←")
		expect(InputMode.glyph(Enum.KeyCode.One).text).toBe("1")
		expect(InputMode.glyph(Enum.KeyCode.MouseRightButton).text).toBe("RMB")
	end)

	it("shows gamepad buttons with engine art and pad-specific text", function()
		InputMode.set("Gamepad")
		local confirm = InputMode.glyph("Confirm")
		expect(confirm.kind).toBe("button")
		expect(confirm.keyCode).toBe(Enum.KeyCode.ButtonA)
		expect(confirm.text).toBe("A")
		expect(confirm.image).toBe("rbxasset://fake/ButtonA.png")
		expect(InputMode.glyph("TabNext").text).toBe("RB")
		rawset(env.userInputService, "_playstation", true)
		expect(InputMode.glyph("Confirm").text).toBe("✕")
		expect(InputMode.glyph("Back").text).toBe("○")
	end)

	it("hides prompts on touch and updates glyphState live", function()
		local glyph = InputMode.glyphState("Back")
		expect(glyph:peek().kind).toBe("key")
		InputMode.set("Gamepad")
		expect(glyph:peek().text).toBe("B")
		InputMode.set("Touch")
		expect(glyph:peek().kind).toBe("none")
	end)

	it("registers actions, rejecting reserved and empty bindings", function()
		InputMode.registerAction("Research", { keyboard = { Enum.KeyCode.R }, gamepad = { Enum.KeyCode.ButtonY } })
		expect(InputMode.keysFor("Research")).toEqual({ Enum.KeyCode.R, Enum.KeyCode.ButtonY })
		expect(InputMode.matches("Research", Enum.KeyCode.ButtonY)).toBe(true)
		expect(InputMode.matches("Research", Enum.KeyCode.ButtonA)).toBe(false)
		expect(InputMode.matches("Nope", Enum.KeyCode.ButtonA)).toBe(false)
		expect(InputMode.action("Research")).never.toBeNil()
		expect(function()
			InputMode.registerAction("Pause", { keyboard = { Enum.KeyCode.Escape }, gamepad = {} })
		end).toThrow("reserved by Roblox")
		expect(function()
			InputMode.registerAction("Menu", { keyboard = {}, gamepad = { Enum.KeyCode.ButtonStart } })
		end).toThrow("reserved by Roblox")
		expect(function()
			InputMode.registerAction("Empty", { keyboard = {}, gamepad = {} })
		end).toThrow("at least one key")
		expect(function()
			InputMode.glyph("Nope")
		end).toThrow("unknown action")
		for _, name in { "Confirm", "Back", "Secondary", "Tertiary", "TabPrev", "TabNext", "PagePrev", "PageNext" } do
			for _, keyCode in InputMode.keysFor(name) do
				expect(InputMode.isReserved(keyCode)).toBe(false)
			end
		end
		expect(InputMode.isReserved(Enum.KeyCode.F9)).toBe(true)
	end)
end)
