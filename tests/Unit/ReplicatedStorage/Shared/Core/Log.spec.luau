local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local Log = require("@game/ReplicatedStorage/Shared/Core/Log")

describe("Log", function()
	local entries
	local previous
	Test.beforeEach(function()
		entries = {}
		previous = Log.setSink(function(level, scope, message)
			table.insert(entries, { level = level, scope = scope, message = message })
		end)
		Log.setLevel("info")
	end)
	Test.afterEach(function()
		Log.setSink(previous)
		Log.setLevel("info")
	end)

	it("formats messages and tags the scope", function()
		local log = Log.scope("CombatService")
		log:info("fired %s at %d m", "AP", 300)
		expect(entries[1]).toEqual({ level = "info", scope = "CombatService", message = "fired AP at 300 m" })
	end)

	it("filters by level", function()
		local log = Log.scope("X")
		log:debug("hidden")
		log:info("shown")
		Log.setLevel("warn")
		log:info("hidden too")
		log:warn("warned")
		log:error("errored")
		expect(#entries).toBe(3)
		expect(entries[2].level).toBe("warn")
		expect(entries[3].level).toBe("error")
		expect(Log.isEnabled("info")).toBe(false)
		expect(Log.isEnabled("error")).toBe(true)
		Log.setLevel("debug")
		log:debug("now visible")
		expect(entries[4].message).toBe("now visible")
		expect(Log.getLevel()).toBe("debug")
	end)

	it("never throws on bad format arguments", function()
		local log = Log.scope("X")
		log:info("%d apples", "not a number")
		expect(entries[1].message).toBe("%d apples not a number")
		log:info("no args with %d")
		expect(entries[2].message).toBe("no args with %d")
	end)

	it("rejects unknown levels and empty scopes", function()
		expect(function()
			Log.setLevel("verbose" :: any)
		end).toThrow("unknown level")
		expect(function()
			Log.scope("")
		end).toThrow("non-empty")
	end)

	it("survives a failing sink", function()
		Log.setSink(function()
			error("sink broke")
		end)
		expect(function()
			Log.scope("X"):info("hello")
		end).never.toThrow()
	end)

	it("setSink returns the previous sink", function()
		local mine = function() end
		Log.setSink(mine)
		expect(Log.setSink(nil)).toBe(mine)
	end)
end)
