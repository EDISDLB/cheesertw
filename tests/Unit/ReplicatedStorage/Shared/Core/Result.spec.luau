local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local Result = require("@game/ReplicatedStorage/Shared/Core/Result")

describe("Result", function()
	it("builds ok and err values", function()
		expect(Result.ok(5)).toEqual({ ok = true, value = 5 })
		expect(Result.err("NOT_FOUND", "vehicle x")).toEqual({ ok = false, err = "NOT_FOUND", detail = "vehicle x" })
		expect(Result.ok(nil)).toBeOk()
		expect(Result.err("X")).toBeErr("X")
	end)

	it("classifies results", function()
		expect(Result.isOk(Result.ok(1))).toBe(true)
		expect(Result.isOk(Result.err("X"))).toBe(false)
		expect(Result.isErr(Result.err("X"))).toBe(true)
		expect(Result.is(Result.ok(false))).toBe(true)
		expect(Result.is(Result.err("X"))).toBe(true)
		expect(Result.is({ ok = false })).toBe(false)
		expect(Result.is({ ok = "yes" })).toBe(false)
		expect(Result.is(nil)).toBe(false)
	end)

	it("unwraps", function()
		expect(Result.unwrap(Result.ok(3))).toBe(3)
		expect(function()
			Result.unwrap(Result.err("INSUFFICIENT_FUNDS", "need 500"))
		end).toThrow("INSUFFICIENT_FUNDS: need 500")
		expect(Result.unwrapOr(Result.err("X"), 7)).toBe(7)
		expect(Result.unwrapOr(Result.ok(1), 7)).toBe(1)
	end)

	it("requires a code", function()
		expect(function()
			Result.err("")
		end).toThrow("non-empty")
	end)
end)
