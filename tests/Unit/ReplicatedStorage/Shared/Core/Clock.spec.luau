local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local Clock = require("@game/ReplicatedStorage/Shared/Core/Clock")

describe("Clock", function()
	it("fake clocks advance and set deterministically", function()
		local clock = Clock.fake(10)
		expect(clock:now()).toBe(10)
		expect(clock:advance(2.5)).toBe(12.5)
		clock:set(100)
		expect(clock:now()).toBe(100)
		expect(Clock.fake():now()).toBe(0)
	end)

	it("fake clocks reject invalid input", function()
		local clock = Clock.fake()
		expect(function()
			clock:advance(-1)
		end).toThrow("dt must be")
		expect(function()
			clock:advance(0 / 0)
		end).toThrow("dt must be")
		expect(function()
			clock:set(math.huge)
		end).toThrow("finite")
	end)

	it("the real clock is monotonic", function()
		local clock = Clock.real()
		local a = clock:now()
		local b = clock:now()
		expect(b).toBeGreaterThanOrEqual(a)
	end)

	it("the wall clock reports unix seconds", function()
		expect(Clock.wall():now()).toBeGreaterThan(1600000000)
	end)
end)
