local Test = require("@tests/Harness/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local InputValidator = require("@game/ReplicatedStorage/Shared/Security/InputValidator")

describe("InputValidator", function()
	it("clamps axes and numbers, mapping garbage to defaults", function()
		expect(InputValidator.clampAxis(0.5)).toBe(0.5)
		expect(InputValidator.clampAxis(5)).toBe(1)
		expect(InputValidator.clampAxis(-5)).toBe(-1)
		expect(InputValidator.clampAxis(0 / 0)).toBe(0)
		expect(InputValidator.clampAxis(math.huge)).toBe(0)
		expect(InputValidator.clampAxis("1")).toBe(0)
		expect(InputValidator.clampNumber(50, 0, 10)).toBe(10)
		expect(InputValidator.clampNumber(nil, 0, 10)).toBe(0)
		expect(InputValidator.clampNumber(nil, 0, 10, 5)).toBe(5)
		expect(InputValidator.finiteOr(0 / 0, 3)).toBe(3)
		expect(InputValidator.finiteOr(2, 3)).toBe(2)
	end)

	it("normalizes directions", function()
		expect(InputValidator.unitVector(Vector3.new(0, 0, 5))).toBeCloseTo(Vector3.new(0, 0, 1))
		expect(InputValidator.unitVector(Vector3.zero)).toEqual(Vector3.new(0, 0, -1))
		expect(InputValidator.unitVector(Vector3.new(0 / 0, 1, 0))).toEqual(Vector3.new(0, 0, -1))
		expect(InputValidator.unitVector("up", Vector3.new(0, 1, 0))).toEqual(Vector3.new(0, 1, 0))
	end)

	it("limits aim points to a radius", function()
		local origin = Vector3.new(0, 0, 0)
		expect(InputValidator.clampAimPoint(Vector3.new(0, 0, 50), origin, 100)).toEqual(Vector3.new(0, 0, 50))
		expect(InputValidator.clampAimPoint(Vector3.new(0, 0, 500), origin, 100)).toBeCloseTo(Vector3.new(0, 0, 100))
		expect(InputValidator.clampAimPoint(Vector3.new(0 / 0, 0, 0), origin, 100)).toEqual(Vector3.new(0, 0, -100))
		expect(InputValidator.clampAimPoint(nil, origin, 10, Vector3.new(1, 0, 0))).toEqual(Vector3.new(10, 0, 0))
	end)

	it("sanitizes strings on UTF-8 boundaries", function()
		expect(InputValidator.sanitizeString("hi\0\n there", 100)).toBe("hi there")
		expect(InputValidator.sanitizeString("abcdef", 3)).toBe("abc")
		-- "é" is 2 bytes: a 2-byte budget fits "a" but not the whole "é".
		local eAcute = utf8.char(0xE9)
		expect(InputValidator.sanitizeString("a" .. eAcute, 2)).toBe("a")
		expect(InputValidator.sanitizeString("a" .. eAcute, 3)).toBe("a" .. eAcute)
		expect(InputValidator.sanitizeString("\255bad", 10)).toBe("")
		expect(InputValidator.sanitizeString(42, 10)).toBe("")
	end)

	it("accepts exact integers in range only", function()
		expect(InputValidator.integerInRange(3, 1, 5)).toBe(3)
		expect(InputValidator.integerInRange(3.5, 1, 5)).toBeNil()
		expect(InputValidator.integerInRange(9, 1, 5)).toBeNil()
		expect(InputValidator.integerInRange("3", 1, 5)).toBeNil()
	end)
end)
